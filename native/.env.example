APP_NAME="Doctor Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://doctorbooking.test
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=doctorbooking
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=
SESSION_DOMAIN=
SESSION_SECURE=false
SESSION_SAME_SITE=lax

CACHE_DRIVER=file

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

LEAD_NOTIFY_EMAIL=
LEAD_NOTIFY_PHONE=

SMS_ENABLED=false
SMS_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_METHOD=GET
SMS_TIMEOUT=10

CORS_ALLOWED_ORIGINS=*
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,doctorbooking.test

LOG_CHANNEL=daily
LOG_LEVEL=debug

STORAGE_PATH=
PUBLIC_PATH=
LARAVEL_ROOT=
