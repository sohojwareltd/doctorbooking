APP_NAME="Doctor Booking"
APP_ENV=local
APP_KEY=base64:OullXbLbg0d8g3mDVxe3g7V8O1m6v/ZT3Iik5JxizJI=
APP_DEBUG=false
APP_URL=http://127.0.0.1:17890

APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# SQLite — offline desktop database (single file)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=127.0.0.1,127.0.0.1:17890,localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="offline@doctorbooking.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
CORS_ALLOWED_ORIGINS=*

# Offline — disable external services
SMS_ENABLED=false
LEAD_NOTIFY_EMAIL=
LEAD_NOTIFY_PHONE=
